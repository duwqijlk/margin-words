# Cloudflare Pages. The page and the files that decide which version runs are checked with the
# server on every visit; only the hashed files in /assets are cached for good.
/
  Cache-Control: no-cache
  CDN-Cache-Control: no-store
/index.html
  Cache-Control: no-cache
  CDN-Cache-Control: no-store
/sw.js
  Cache-Control: no-cache
  CDN-Cache-Control: no-store
/manifest.webmanifest
  Cache-Control: no-cache
  CDN-Cache-Control: no-store
/kit/*
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
