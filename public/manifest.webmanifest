{
  "name": "inputread",
  "short_name": "inputread",
  "description": "An English reader for original English books. Tap a word to see a simple English meaning, save it, and review it.",
  "start_url": "/shelf/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#ffffff",
