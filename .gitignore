# dependencies and build output
node_modules/
dist/
dist-books/
dist-private/
dist-functions/
site/
.vite/
.node_modules.lock
*.log
.DS_Store
.vercel/
.wrangler/
.output/
.nitro/

# Regenerable zips: `node scripts/build-packs.mjs` (packs/) and
# `node scripts/build-packs.mjs --out public-books` (public-books/) rebuild them from book.epub + glossary.json.
packs/*.zip
public-books/*.zip

# Book files are not stored in git. Copyrighted EPUBs belong in the private R2 bucket
# margin-words-private. Public-domain EPUBs belong on the books host. The sample EPUB
# under examples/ is this project's own text and stays in git.
*.epub
!examples/sample-book/the-lantern-seller.epub

# Redundant per-book pack zips in the classics sources (rebuild: node scripts/make-pack.mjs book.epub glossary.json out.pack.zip)
classics/**/*.pack.zip

# Layout-shift test output
layout-shift-out/
